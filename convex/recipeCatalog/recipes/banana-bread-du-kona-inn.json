        },
        {
          "name": "chopped pecans",
          "quantity": "60",
          "unit": "g",
          "notes": "for the optional topping",
          "id": "ingredient-main-9"
        },
        {
          "name": "dark brown sugar",
          "quantity": "2",
          "unit": "tbsp",
          "notes": "for the optional topping",
          "id": "ingredient-main-10"
        },
        {
          "name": "cinnamon",
          "quantity": "1/2",
          "unit": "tsp",
          "notes": "for the optional topping",
          "id": "ingredient-main-11"
        }
      ],
      "sections": [
        {
          "title": "Preparation",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Preheat the oven to 175 °C and lightly grease the loaf pan.",
              "ingredientUses": []
            },
            {
              "id": "step-0-5",
              "text": "Melt the butter in a saucepan over low heat, then let it cool slightly off the heat.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "While the butter melts, combine the flour, baking soda, salt and cinnamon in a first bowl. Ideally, sift this mixture.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-6"
                },
                {
                  "ingredientId": "ingredient-main-8"
                }
              ]
            },
            {
              "id": "step-0-6",
              "text": "Mash the bananas with a fork.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-0-1",
              "text": "Pour the warm melted butter into a second, larger bowl. Add the sugar and whisk until smooth.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                },
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Add the beaten eggs, then the mashed bananas, and mix until smooth.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-0-7",
              "text": "Add the contents of the first bowl to the large bowl and fold with a spatula just until no dry flour remains. Do not overmix.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-4"
                },
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-6"
                },
                {
                  "ingredientId": "ingredient-main-8"
                }
              ]
            },
            {
              "id": "step-0-4",
              "text": "Fold in the chopped pecans.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-7"
                }
              ]
            }
          ]
        },
        {
          "title": "Crunchy Pecan Topping (Optional)",
          "steps": [
            {
              "id": "step-3-0",
              "text": "If making the topping: mix the topping pecans, dark brown sugar and cinnamon.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-9"
                },
                {
                  "ingredientId": "ingredient-main-10"
                },
                {
                  "ingredientId": "ingredient-main-11"
                }
              ]
            },
            {
              "id": "step-3-1",
              "text": "Pour half the batter into the pan and sprinkle with half the pecan mixture.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-9"
                }
              ]
            },
            {
              "id": "step-3-2",
              "text": "Add the remaining batter, sprinkle the rest of the mixture on top and press it in lightly.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-9"
                }
              ]
            }
          ]
        },
        {
          "title": "Baking",
          "steps": [
            {
              "id": "step-1-0",
              "text": "Without the topping, pour all the batter into the pan.",
              "ingredientUses": []
            },
            {
              "id": "step-1-1",
              "text": "Bake for 45 to 60 min, until the center is firm and a knife or toothpick inserted into it comes out clean or almost clean.",
              "ingredientUses": []
            },
            {
              "id": "step-1-2",
              "text": "Let cool in the pan for 10 min, then unmold onto a rack.",
              "ingredientUses": []
            }
          ]
        },
        {
          "title": "Storage",
          "steps": [
            {
              "id": "step-2-0",
              "text": "This banana bread freezes very well.",
              "ingredientUses": []
            }
          ]
        }
      ],
      "subRecipes": [],
      "notes": [
        "Add the flour all at once and mix only until no dry flour remains: the batter can stay a little lumpy, that’s normal. Overmixing makes the banana bread dense and can make it sink in the middle."
      ]
    }
