      "sections": [
        {
          "title": "Préparation",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Cuire les pommes de terre, pas trop, pour qu’elles restent fermes.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-1",
              "text": "Faire revenir les oignons pelés et émincés (enlever le germe).",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "Lorsqu’ils deviennent translucides, ajouter les lardons. Poursuivre la cuisson pour que lardons et oignons soient dorés.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "Déglacer la poêle avec le vin blanc et poursuivre la cuisson 5 minutes.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-4"
                }
              ]
            },
            {
              "id": "step-0-4",
              "text": "Préchauffer le four à 200 °C.",
              "ingredientUses": []
            },
            {
              "id": "step-0-5",
              "text": "Couper les pommes de terre en grosses rondelles.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-6",
              "text": "Couper le reblochon en deux horizontalement.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                }
              ]
            }
          ]
        },
        {
          "title": "Montage",
          "steps": [
            {
              "id": "step-1-0",
              "text": "Beurrer un plat à gratin.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-8"
                }
              ]
            },
            {
              "id": "step-1-1",
              "text": "Répartir les pommes de terre dans le plat, mélangées avec un peu de crème fraîche, le poivre, la muscade et un peu de sel (très peu, et uniquement si les pommes de terre n’ont pas été cuites dans l’eau salée).",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                },
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-6"
                },
                {
                  "ingredientId": "ingredient-main-7"
                },
                {
                  "ingredientId": "ingredient-main-9"
                }
              ]
            },
            {
              "id": "step-1-2",
              "text": "Ajouter les oignons et les lardons.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-1-3",
              "text": "Recouvrir du reste de crème fraîche, puis du reblochon, croûte vers le haut.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-1"
                }
              ]
            }
          ]
        },
        {
          "title": "Cuisson",
          "steps": [
            {
              "id": "step-2-0",
              "text": "Mettre au four 30 minutes, jusqu’à ce que le reblochon forme une croûte bien dorée et gratinée.",
              "ingredientUses": []
            },
            {
              "id": "step-2-1",
              "text": "Servir la tartiflette accompagnée d’une belle salade verte et d’un verre de vin blanc de Savoie.",
              "ingredientUses": []
            }
          ]
        }
      ],
      "subRecipes": [],
      "notes": []
