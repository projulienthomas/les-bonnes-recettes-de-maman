    "en": {
      "title": "Tartiflette",
      "author": "Maman",
      "description": "Tartiflette with Reblochon cheese, potatoes, onions and smoked bacon lardons, baked until golden.",
      "yieldLabel": "6 people",
      "prepTime": "40 min",
      "cookTime": "30 min",
      "restTime": "",
      "totalTime": "1 h 10",
      "timeLabel": "1 h 10",
      "temperature": "200 °C",
      "equipment": [
        "1 saucepan",
        "1 frying pan",
        "1 gratin dish"
      ],
      "ingredients": [
        {
          "name": "potatoes",
          "quantity": "1.5",
          "unit": "kg",
          "notes": "waxy",
          "id": "ingredient-main-0"
        },
        {
          "name": "Reblochon cheese",
          "quantity": "500",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-1"
        },
        {
          "name": "smoked bacon lardons",
          "quantity": "200",
          "unit": "g",
          "notes": "or cured ham",
          "id": "ingredient-main-2"
        },
        {
          "name": "large onion",
          "quantity": "1",
          "unit": "",
          "notes": "or 2 medium",
          "id": "ingredient-main-3"
        },
        {
          "name": "dry white wine",
          "quantity": "1",
          "unit": "glass",
          "notes": "optional",
          "id": "ingredient-main-4"
        },
        {
          "name": "thick crème fraîche",
          "quantity": "100",
          "unit": "g",
          "notes": "",
          "id": "ingredient-main-5"
        },
        {
          "name": "white pepper",
          "quantity": "",
          "unit": "",
          "notes": "",
          "id": "ingredient-main-6"
        },
        {
          "name": "nutmeg",
          "quantity": "1",
          "unit": "pinch",
          "notes": "",
          "id": "ingredient-main-7"
        },
        {
          "name": "butter",
          "quantity": "",
          "unit": "",
          "notes": "for the dish",
          "id": "ingredient-main-8"
        },
        {
          "name": "salt",
          "quantity": "",
          "unit": "",
          "notes": "very little, and only if the potatoes were not cooked in salted water",
          "id": "ingredient-main-9"
        }
      ],
      "sections": [
        {
          "title": "Preparation",
          "steps": [
            {
              "id": "step-0-0",
              "text": "Cook the potatoes, but not too much, so that they stay firm.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-1",
              "text": "Peel and slice the onions (remove the germ), then fry them gently.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                }
              ]
            },
            {
              "id": "step-0-2",
              "text": "When they turn translucent, add the lardons. Keep cooking until the lardons and onions are golden.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-0-3",
              "text": "Deglaze the pan with the white wine and cook for another 5 minutes.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-4"
                }
              ]
            },
            {
              "id": "step-0-4",
              "text": "Preheat the oven to 200 °C.",
              "ingredientUses": []
            },
            {
              "id": "step-0-5",
              "text": "Cut the potatoes into thick slices.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                }
              ]
            },
            {
              "id": "step-0-6",
              "text": "Cut the Reblochon in half horizontally.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-1"
                }
              ]
            }
          ]
        },
        {
          "title": "Assembly",
          "steps": [
            {
              "id": "step-1-0",
              "text": "Butter a gratin dish.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-8"
                }
              ]
            },
            {
              "id": "step-1-1",
              "text": "Spread the potatoes in the dish, mixed with a little crème fraîche, the pepper, the nutmeg and a little salt (very little, and only if the potatoes were not cooked in salted water).",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-0"
                },
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-6"
                },
                {
                  "ingredientId": "ingredient-main-7"
                },
                {
                  "ingredientId": "ingredient-main-9"
                }
              ]
            },
            {
              "id": "step-1-2",
              "text": "Add the onions and lardons.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-3"
                },
                {
                  "ingredientId": "ingredient-main-2"
                }
              ]
            },
            {
              "id": "step-1-3",
              "text": "Cover with the rest of the crème fraîche, then with the Reblochon, rind side up.",
              "ingredientUses": [
                {
                  "ingredientId": "ingredient-main-5"
                },
                {
                  "ingredientId": "ingredient-main-1"
                }
              ]
            }
          ]
        },
        {
          "title": "Baking",
          "steps": [
            {
              "id": "step-2-0",
              "text": "Bake for 30 minutes, until the Reblochon forms a golden, bubbling crust.",
              "ingredientUses": []
            },
            {
              "id": "step-2-1",
              "text": "Serve the tartiflette with a nice green salad and a glass of Savoie white wine.",
              "ingredientUses": []
            }
          ]
        }
      ],
      "subRecipes": [],
      "notes": []
    }
  },
